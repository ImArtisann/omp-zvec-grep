{
  "name": "omp-zvec-grep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native Oh My Pi zvec-grep search, indexing, and status tools",
  "license": "Apache-2.0",
  "homepage": "https://github.com/ImArtisann/omp-zvec-grep",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImArtisann/omp-zvec-grep.git"
  },
  "bugs": {
    "url": "https://github.com/ImArtisann/omp-zvec-grep/issues"
  },
  "keywords": [
    "oh-my-pi",
    "omp",
    "extension",
    "zvec-grep",
    "semantic-search",
    "code-search",
    "local-first"
  ],
  "files": [
    "index.ts",
    "src",
    "LICENSE",
    "UPSTREAM.md",
    "README.md",
    "docs"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "omp": {
    "extensions": ["./index.ts"]
  },
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "typecheck": "tsc --noEmit --strict",
    "lint": "oxlint .",
    "format:check": "oxfmt --check --no-error-on-unmatched-pattern '**/*.{ts,tsx}'",
    "format": "oxfmt --no-error-on-unmatched-pattern '**/*.{ts,tsx}'",
    "test": "bun run test:hermetic && bun run test:integration && bun run test:cli",
    "test:hermetic": "bun test test/hermetic",
    "test:integration": "bun test test/integration",
    "test:cli": "bun test test/cli"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.1.11",
    "@oh-my-pi/pi-tui": "18.1.11",
    "@oh-my-pi/pi-utils": "18.1.11"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.1.11",
    "@oh-my-pi/pi-tui": "18.1.11",
    "@oh-my-pi/pi-utils": "18.1.11",
    "@types/bun": "1.3.4",
    "oxfmt": "0.21.0",
    "oxlint": "1.40.0",
    "typescript": "5.9.3"
  }
}
